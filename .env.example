# Sanity project (sanity.io/manage → your project → Project ID)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public address of the site, used for SEO links and the sitemap
NEXT_PUBLIC_SITE_URL=https://everydayplate.com

# Optional: any long random string. Must match the secret in the Sanity webhook.
SANITY_REVALIDATE_SECRET=
